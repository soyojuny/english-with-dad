{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "incremental": false,
    "sourceMap": true,
    "inlineSources": true,
    "types": ["node"],
    "plugins": []
  },
  "include": ["lib/**/*.ts", "tests/*.test.ts", "tests/unit/**/*.test.ts", "tests/helpers/**/*.ts"],
  "exclude": ["node_modules", ".next", ".test-build"]
}
