{
  "name": "english-with-dad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsc -p tsconfig.test.json && node --test .test-build/tests/reading-calculations.test.js",
    "plan:workflow": "node scripts/plan-workflow.mjs",
    "git:status": "node scripts/git-publish.mjs status",
    "git:commit": "node scripts/git-publish.mjs commit",
    "git:push": "node scripts/git-publish.mjs push",
    "git:publish": "node scripts/git-publish.mjs publish",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:sw": "node --check public/sw.js",
    "check:pwa": "node scripts/check-pwa.mjs",
    "verify": "npm run check:contracts && npm run check:sw && npm run check:pwa && npm run test:unit && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.0",
    "jsqr": "^1.4.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
