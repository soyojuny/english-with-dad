{
  "name": "english-with-dad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:harness": "node --test tests/harness/*.test.mjs",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:audio-browser": "node scripts/smoke-audio-completion.mjs",
    "test:browser": "playwright test",
    "test:browser:client": "playwright test --project=client-http",
    "test:browser:next": "playwright test --project=next-auth-http",
    "plan:workflow": "node scripts/plan-workflow.mjs",
    "plan:archive": "node scripts/plan-archive.mjs",
    "git:status": "node scripts/git-publish.mjs status",
    "git:commit": "node scripts/git-publish.mjs commit",
    "git:push": "node scripts/git-publish.mjs push",
    "git:publish": "node scripts/git-publish.mjs publish",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:sw": "node --check public/sw.js",
    "check:pwa": "node scripts/check-pwa.mjs",
    "verify": "npm run check:contracts && npm run check:sw && npm run check:pwa && npm run test:unit && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.0",
    "jsqr": "^1.4.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "^5.8.0",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
